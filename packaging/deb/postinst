#!/bin/sh
set -e
mkdir -p /usr/share/mcmanager /etc/mcmanager
chmod 755 /usr/bin/mcmanager || true

# Utilisateur dedie pour le service mcmanager-server (pas de root pour les serveurs Minecraft).
if ! getent passwd mcmanager >/dev/null 2>&1; then
  adduser --system --group --home /var/lib/mcmanager --no-create-home --quiet mcmanager 2>/dev/null \
    || useradd --system --user-group --home-dir /var/lib/mcmanager --no-create-home mcmanager 2>/dev/null || true
fi
mkdir -p /var/lib/mcmanager
chown mcmanager:mcmanager /var/lib/mcmanager 2>/dev/null || true
[ -f /etc/mcmanager/autostart.txt ] || : > /etc/mcmanager/autostart.txt
[ -f /etc/mcmanager/server.env ] || cat > /etc/mcmanager/server.env <<'ENVEOF'
# Configuration du service mcmanager-server (lue par systemd).
# MCMANAGER_PORT=7777
# MCMANAGER_HOST=0.0.0.0
# Compte administrateur cree au premier demarrage (sinon : 'admin' + mot de passe aleatoire dans les logs) :
# MCMANAGER_ADMIN_USER=admin
# MCMANAGER_ADMIN_PASSWORD=changez-moi
# Derriere un reverse proxy HTTPS :
# MCMANAGER_TRUST_PROXY=1
# MCMANAGER_COOKIE_SECURE=1
ENVEOF
chmod 640 /etc/mcmanager/server.env
chgrp mcmanager /etc/mcmanager/server.env 2>/dev/null || true

# Ancien service (avant 1.0.8) renomme : on le desactive pour ne pas avoir deux instances.
if systemctl is-enabled mcmanager-headless >/dev/null 2>&1; then
  systemctl disable --now mcmanager-headless >/dev/null 2>&1 || true
  echo "Ancien service mcmanager-headless desactive (remplace par mcmanager-server)."
  echo "Ses donnees etaient dans le dossier du compte qui le lancait : pour les reprendre, copiez-les dans /var/lib/mcmanager (chown mcmanager:mcmanager)."
fi

command -v update-desktop-database >/dev/null 2>&1 && update-desktop-database /usr/share/applications >/dev/null 2>&1 || true
command -v gtk-update-icon-cache >/dev/null 2>&1 && gtk-update-icon-cache -f /usr/share/icons/hicolor >/dev/null 2>&1 || true
echo ""
echo "MCManager installe."
echo "Poste de travail : commande mcmanager -> http://127.0.0.1:7777"
echo ""
echo "Mode serveur (VPS / machine distante) :"
echo "  mcmanager-server                              -> shell interactif (configuration en SSH)"
echo "  sudo systemctl enable --now mcmanager-server -> interface web multi-utilisateurs + controle a distance, au demarrage"
echo "  Le mot de passe admin initial s'affiche dans : sudo journalctl -u mcmanager-server"
echo "  Configuration : /etc/mcmanager/server.env   Demarrage auto de serveurs : /etc/mcmanager/autostart.txt"
exit 0
